{
  "name": "appnation-chat-backend",
  "version": "0.1.0",
  "private": true,
  "description": "AI Chat backend with feature flagging, runtime behavior switching, SOLID + Clean Architecture",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "tsx watch src/server.ts",
    "dev:web": "pnpm --dir frontend dev",
    "build": "tsc -p tsconfig.build.json",
    "build:web": "pnpm --dir frontend build",
    "build:all": "pnpm build && pnpm build:web",
    "start": "node dist/server.js",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "lint:web": "pnpm --dir frontend lint",
    "format": "prettier --write .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "pnpm --dir frontend exec tsc --noEmit -p tsconfig.json",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm prisma:check",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:check": "DATABASE_URL=postgresql://check:check@localhost:5432/check prisma validate && prisma format --check --schema ./prisma/schema.prisma",
    "hooks:install": "husky",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.0.0",
    "@anthropic-ai/sdk": "^0.30.1",
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "@prisma/client": "^5.22.0",
    "ai": "^4.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.0.3",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.14.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.7",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "@vitest/coverage-v8": "^2.1.4",
    "concurrently": "^9.1.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.31.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "pino-pretty": "^11.3.0",
    "prettier": "^3.3.3",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "testcontainers": "^11.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "tests/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "frontend/src/**/*.{ts,tsx}": [
      "pnpm --dir frontend exec eslint --fix",
      "pnpm --dir frontend exec prettier --write"
    ],
    "prisma/schema.prisma": [
      "prisma format --schema"
    ],
    "*.{md,json,yml,yaml}": [
      "prettier --write"
    ]
  }
}
