{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile=false && pnpm prisma generate",
  "buildCommand": "true",
  "outputDirectory": ".",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "headers": [
    {
      "source": "/docs.json",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
