# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/appnation_chat?schema=public&connection_limit=10&pool_timeout=20

# Auth (mocked)
JWT_SECRET=replace-me-with-a-random-string-of-at-least-32-characters
APP_CHECK_TOKEN=replace-me-with-a-random-app-check-token

# AI providers — at least one key recommended; falls back to a deterministic
# mock provider when all are missing. Selection priority: Anthropic > OpenAI > Groq.
# Tool-agent analysis path uses FallbackAiProvider(Groq -> Anthropic) when both keys are set.

# Prime — Anthropic Claude Sonnet 4.6 (direct Anthropic API)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Fast — Groq (OpenAI-compatible endpoint)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Additional supported provider — OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Feature flags (defaults shown)
STREAMING_ENABLED=true
PAGINATION_LIMIT=20
AI_TOOLS_ENABLED=false
CHAT_HISTORY_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
# Kill-switch for the AI completion route. Default true; flip to false +
# `kill -HUP $PID` to disable globally without redeploy.
COMPLETION_ENABLED=true

# Per-tool toggles. AI_TOOLS_ENABLED is the master switch — when off, all
# of these are ignored. When the master is on, only tools whose flag is
# true are exposed to the model. Default: all on, so adding a new tool
# doesn't surprise existing deployments.
TOOL_CALCULATOR_ENABLED=true
TOOL_CURRENT_TIME_ENABLED=true
TOOL_CURRENT_WEATHER_ENABLED=true
TOOL_CONVERT_CURRENCY_ENABLED=true
TOOL_SEARCH_WEB_ENABLED=true

# Optional: token gating POST /admin/flags/reload. Must be ≥16 chars when set.
# Leave unset to disable the admin endpoint entirely (404). Useful on serverless
# where SIGHUP isn't deliverable to function instances.
ADMIN_TOKEN=

# Optional tracing extension hook. The bundled tracing scaffold (see
# src/infrastructure/tracing/span.ts) emits structured `span` log lines for
# every wrapped operation. To export to a real APM (Honeycomb, Grafana
# Tempo, Jaeger, …), wire @opentelemetry/sdk-node in src/server.ts before
# any other module loads and point this var at the OTLP collector URL.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=fluxchat-api

# OpenAPI / Swagger UI toggle. Default ON.
# Set to false to remove /docs and /docs.json from the deployment (they then 404).
DOCS_ENABLED=true

# Optional: JSON file with feature flag overrides (hot-reloadable on SIGHUP)
# FEATURE_FLAGS_FILE=./feature-flags.json

# Optional: Redis URL for multi-instance rate limiting. When omitted, the app
# uses an in-memory store (fine for a single process; not safe for horizontal scale).
# REDIS_URL=redis://localhost:6379
